# YouTube Data API Configuration
# Get your API key from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_api_key_here

# Get your channel ID from: https://www.youtube.com/@oioracing
YOUTUBE_CHANNEL_ID=your_channel_id_here

# Instagram Basic Display API (optional)
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here

# Spreadshirt Public Shop API — build-time only, never shipped to the browser.
# Get your key from https://partner.spreadshirt.com/apiKey (North America)
# or https://partner.spreadshirt.net/apiKey (Europe).
# Used by `pnpm sync:merch` to regenerate src/data/merch/catalog.json.
SPREADSHIRT_API_KEY=your_spreadshirt_api_key_here
