---
interface Props {
  product: {
    id: string;
    designName: string;
    label: string;
    brand: string | null;
    price: number;
    image: string;
    colorCount: number;
  };
}

const { product } = Astro.props;

// Cards crop into the chest print, so ask the image server for more pixels than
// the card is wide — a 500px render scaled 1.9x is visibly soft.
const highRes = product.image?.replace(/width=\d+,height=\d+/, "width=1000,height=1000");
---

<button class="card" data-product-id={product.id} type="button">
  <span class="card__frame">
    <img src={highRes} alt={`${product.designName} ${product.label}`} loading="lazy" />
  </span>
  <span class="card__name">{product.designName}</span>
  {/* Blank and brand ("Unisex Tee · Bella + Canvas") used to run here as a
      corner-label on every card. Per Ian: drop it from the thumbnail — it's
      shelf clutter, not a decision a shopper makes from the grid. It still
      appears as plain text in the drawer's description, on the product that
      actually carries it. */}
  <span class="card__meta">
    <span>{product.colorCount} {product.colorCount === 1 ? "color" : "colors"}</span>
    <span class="card__price">${product.price.toFixed(2)}</span>
  </span>
</button>

<style>
  /* Not a panel. The card was a Surface 2 block on a Surface ground — one step
     up, square, no shadow. Per Ian: everything floats on the single darkest
     ground instead, so the fill comes off entirely and the shirt is the only
     thing on the page with a shape. What used to be the card's inset padding
     goes too: with no fill to inset from, padding only pushed the title away
     from the art it labels. Separation is the grid gap now, not a box. */
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    background: none;
    color: var(--apex-white);
    text-align: left;
    border: none;
    cursor: pointer;
  }

  /* Hover was a fill change, which a fill-less card cannot do. The push into
     the print carries it alone — it is the same gesture, just without the box
     lighting up behind it. */

  /* The frame is now the same colour as everything else — the page ground, the
     card that used to sit on it, and the studio background baked into the
     mockup itself by the image server. Three surfaces that were a step apart
     collapse to one, so the garment reads as floating rather than framed.
     Ground colour is Tailwind zinc-950, what BaseLayout paints on <body>;
     keep FRAME_BG in scripts/sync-catalog.mjs matching it. */
  .card__frame {
    position: relative;
    display: block;
    aspect-ratio: 1;
    background: var(--merch-ground);
    /* Same Steel Dark hairline as the rule under each title, so the frame edge
       and the meta rule read as one system rather than two weights. It came off
       when the frame still had a Surface step to define it; with every surface
       collapsed to one ground, a dark shirt has no edge at all without this. */
    border: 1px solid var(--apex-steel-dark);
    overflow: hidden;
  }

  /* Crop into the shoulder-and-chest of the blank rather than showing the whole
     folded shirt. A full product shot at card size is mostly empty fabric; the
     print is the thing being sold. Origin sits left of centre and high so the
     left shoulder seam stays in frame and anchors the garment. */
  .card__frame img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transform: scale(1.9) translateY(10%);
    transform-origin: 40% 42%;
    transition: transform 0.4s ease;
  }

  .card:hover .card__frame img {
    transform: scale(2) translateY(10%);
  }

  .card__name {
    font-family: var(--apex-font-lead);
    font-size: var(--apex-h6);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    line-height: 1.15;
  }

  .card__meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    /* Pinned to the bottom so price rules line up across a row of cards whose
       titles wrap to different heights. */
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--apex-steel-dark);
    font-family: var(--apex-font-mono);
    font-size: var(--apex-caption);
    color: var(--apex-steel-light);
  }

  /* Data is mono and tabular so digits line up down the column. The accent
     lands here and on the buy button — the price is the payoff. */
  .card__price {
    color: var(--apex-spark);
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  @media (prefers-reduced-motion: reduce) {
    .card__frame img {
      transition: none;
    }
  }
</style>
